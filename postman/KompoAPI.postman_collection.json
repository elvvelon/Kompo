  "item": [
    {
      "name": "Authentication & Users",
      "item": [
        {
          "name": "Register User (201 Created)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.access) { pm.collectionVariables.set('access_token', jsonData.access); }",
                  "    if (jsonData.refresh) { pm.collectionVariables.set('refresh_token', jsonData.refresh); }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"vvelon_builder\",\n  \"first_name\": \"Danylo\",\n  \"last_name\": \"Maister\",\n  \"email\": \"vvelon@example.com\",\n  \"password\": \"StrongPassword123!\",\n  \"password_confirmation\": \"StrongPassword123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users",
                "register"
              ]
            },
            "description": "Register a new user account and store access_token and refresh_token in collection variables."
          },
          "response": []
        },
        {
          "name": "Refresh JWT Token (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.access) { pm.collectionVariables.set('access_token', jsonData.access); }",
                  "    if (jsonData.refresh) { pm.collectionVariables.set('refresh_token', jsonData.refresh); }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/token/refresh/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users",
                "token",
                "refresh",
                ""
              ]
            },
            "description": "Rotate refresh token and obtain a new access token (old refresh token is blacklisted)."
          },
          "response": []
        },
        {
          "name": "Get Current User Profile (200 OK)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
